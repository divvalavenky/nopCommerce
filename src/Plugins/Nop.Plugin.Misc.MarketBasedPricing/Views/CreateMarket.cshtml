@model MarketModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.MarketBasedPricing.Markets.AddNew").Text;
}

<form asp-controller="MarketBasedPricing" asp-action="CreateMarket" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Misc.MarketBasedPricing.Markets.AddNew")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="Configure">@T("Plugins.Misc.MarketBasedPricing.Markets.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/Misc.MarketBasedPricing/Views/_CreateOrUpdateMarket.cshtml", Model)
</form>
